<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="wailsail"
        Arguments=""
        InstallLocation="C:\Program Files\wailsail\wailsail">
    </Installer>
    <PackageInformation
        PackageName="wailsail"
        PackageDisplayName="wailsail"
        PublisherName="CN=wailsail"
        PublisherDisplayName="wailsail"
        Version="0.2.1.0"
        PackageDescription="An original Kubernetes desktop client written in Go with Wails v3">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.wailsail.app"
                Description="An original Kubernetes desktop client written in Go with Wails v3"
                DisplayName="wailsail"
                ExecutableName="wailsail"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>wailsail</DisplayName>
            <PublisherDisplayName>wailsail</PublisherDisplayName>
            <Description>An original Kubernetes desktop client written in Go with Wails v3</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="wailsail.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
